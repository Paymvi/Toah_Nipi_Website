# Variable NAMES used by the staff blog editor (placeholders only).
# Real values go in .env.local (git-ignored) for local development, and in
# Vercel: Project Settings > Environment Variables. Values come from the
# WEBSITE's Supabase project (never the booking app's).

# Public: bundled into the browser code. Safe to expose; the database enforces
# every permission. Supabase: Project Settings > Data API / API Keys.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# SERVER ONLY: used by api/blog-process-upload.js to check uploaded PDFs and
# make them live. Never prefix with VITE_, never commit a real value.
# Supabase: Project Settings > API Keys > Secret keys (or legacy service_role).
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
