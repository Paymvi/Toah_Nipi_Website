{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "toah-nipi.vercel.app"
        }
      ],
      "destination": "https://toahnipi.org/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "toah-nipi.vercel.app"
        }
      ],
      "destination": "https://toahnipi.org/:path*",
      "permanent": true
    },
